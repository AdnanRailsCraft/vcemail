# Database Configuration
DATABASE_URL="file:./dev.db"
# For production with PostgreSQL:
# DATABASE_URL="postgresql://user:password@host:port/dbname"

# Authentication Configuration (Required)
NEXTAUTH_SECRET="your-secret-key"
NEXTAUTH_URL="http://localhost:3000"

# User Passwords (Required)
ADMIN_PASSWORD="your-secure-admin-password"
GUEST_PASSWORD="your-secure-guest-password"

# Guest UI Credentials (Required)
NEXT_PUBLIC_GUEST_EMAIL="readonly@vcemail.local"
NEXT_PUBLIC_GUEST_PASSWORD="your-secure-guest-password"

# Email Configuration for Outgoing Mail (Optional)
EMAIL_SERVER_HOST="smtp.example.com"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER="your-email@example.com"
EMAIL_SERVER_PASSWORD="your-smtp-password"

# IMAP Configuration for Receiving Emails
# Required IMAP variables:
IMAP_HOST="imap.example.com"
IMAP_USER="your-email@example.com"
IMAP_PASSWORD="your-imap-password"

# Optional IMAP variables (with defaults):
IMAP_PORT="993"
IMAP_MAILBOX="INBOX"
IMAP_MARK_AS_SEEN="false"
IMAP_FETCH_LIMIT="50"

# Node Environment (Optional)
NODE_ENV="development"
