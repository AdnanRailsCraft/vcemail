# Database
DATABASE_URL="file:./dev.db"

# Authentication
NEXTAUTH_SECRET="generate-a-secure-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Initial User Passwords (for seeding/maintenance scripts)
ADMIN_PASSWORD="set-your-admin-password-here"
GUEST_PASSWORD="set-your-guest-password-here"

# Public Guest Credentials (for 'Sign in as Guest' button)
NEXT_PUBLIC_GUEST_EMAIL="readonly@vcemail.local"
NEXT_PUBLIC_GUEST_PASSWORD="set-your-guest-password-here"

# Email Configuration (SMTP)
EMAIL_SERVER_HOST="smtp.gmail.com"
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER="your-email@domain.com"
EMAIL_SERVER_PASSWORD="your-app-password"
EMAIL_FROM="no-reply@your-domain.com"
